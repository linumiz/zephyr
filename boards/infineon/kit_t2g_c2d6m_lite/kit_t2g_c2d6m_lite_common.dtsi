#include <arm/infineon/cat1c/traveo/cyt4dn/system_clocks.dtsi>
#include <arm/infineon/cat1c/traveo/cyt4dn/cyt4dn.dtsi>
#include <arm/infineon/cat1c/traveo/cyt4dn/cyt4dn-pinctrl.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/pinctrl/ifx_cat1-pinctrl.h>

/ {
	aliases {
		led0 = &user_led1;
		led1 = &user_led2;
		led2 = &user_led3;
		sw0 = &user_bt1;
		sw1 = &user_bt2;
	};

	leds {
		compatible = "gpio-leds";
		user_led1: user_led1 {
			label = "LED_1";
			gpios = <&gpio_prt7 5 GPIO_ACTIVE_HIGH>;
		};
		user_led2: user_led2 {
			label = "LED_2";
			gpios = <&gpio_prt7 6 GPIO_ACTIVE_HIGH>;
		};
		user_led3: user_led3 {
			label = "LED_3";
			gpios = <&gpio_prt7 7 GPIO_ACTIVE_HIGH>;
		};
	};

	gpio_keys {
		compatible = "gpio-keys";

		user_bt1: user_btn1 {
			label = "SW_1";
			gpios = <&gpio_prt0 2 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			zephyr,code = <INPUT_KEY_0>;
		};
		user_bt2: user_btn2 {
			label = "SW_2";
			gpios = <&gpio_prt0 3 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			zephyr,code = <INPUT_KEY_1>;
		};
	};
};

uart7: &scb7 {
	compatible = "infineon,uart";
	current-speed = <115200>;
	dmas = <&dma1 30>, <&dma1 31>;
	dma-names = "tx", "rx";
	clocks = <&clk_peri1 15 0 1>;

	/* UART pins */
	pinctrl-0 = <&p9_0_scb7_uart_rx &p9_1_scb7_uart_tx>;
	pinctrl-names = "default";
};

uart9: &scb9 {
	compatible = "infineon,uart";
	current-speed = <115200>;
	dmas = <&dma1 34>, <&dma1 35>;
	dma-names = "tx", "rx";
	clocks = <&clk_peri1 17 0 0>;

	/* UART pins */
	pinctrl-0 = <&p29_0_scb9_uart_rx &p29_1_scb9_uart_tx>;
	pinctrl-names = "default";
};

&dma1 {
	status = "okay";
};

&clk_peri1 {
	status = "okay";
};

