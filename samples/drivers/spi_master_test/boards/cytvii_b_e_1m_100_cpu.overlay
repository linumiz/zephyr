/* Configure SCB0 as SPI Master */
&scb1 {
	compatible = "infineon,cat1-spi-pdl";
	status = "okay";

	#address-cells = <1>;
	#size-cells = <0>;

	slave_test: test-spi-slave@0 {
		compatible = "vnd,spi-device";
		reg = <0>;
		spi-max-frequency = <1000000>;
	};

	dmas = <&dma1 12>, <&dma1 11>;
	dma-names = "tx", "rx";
};