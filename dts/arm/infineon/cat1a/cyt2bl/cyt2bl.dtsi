		tcpwm0: tcpwm0@40380000{
				reg = <0x40380000 0x2980>;
				#address-cells = <1>;
				#size-cells = <1>;
				tcpwm0_grp0: tcpwm@40380000 {
				reg = <0x40380000 0x1f80>;
