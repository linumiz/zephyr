				#size-cells = <1>;
				tcpwm0_grp0_pwm: pwm@40380000 {
					compatible = "infineon,cat1-pwm";
					reg = <0x40380000 0x1f80>;
					#address-cells = <1>;
					#size-cells = <0>;
					#pwm-cells = <3>;
					resolution = <16>;
