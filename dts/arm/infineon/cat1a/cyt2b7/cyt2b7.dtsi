		tcpwm0_grp0: tcpwm0@40380000  {
			reg = <0x40380000 0x80>;
			#address-cells = <1>;
			#size-cells = <1>;

			tcpwm0_0: tcpwm0_0@40380000 {
				compatible = "infineon,tcpwm";
				reg = <0x40380000 0x80>;
				resolution = <16>;
				status = "disabled";

				counter0_0: counter0_0 {
					compatible = "infineon,tcpwm-counter";
					system-interrupts = <552 4>;
					status = "disabled";
				};

				pwm0_0: pwm0_0 {
					compatible = "infineon,cat1-pwm";
					system-interrupts = <552 4>;
					#pwm-cells = <3>;
					status = "disabled";
				};

				tgpio0_0: tgpio0_0 {
					compatible = "infineon,tcpwm-tgpio";
					system-interrupts = <552 4>;
					status = "disabled";
        			};
			};

		tcpwm0_1: tcpwm0_1@40380080 {
			compatible = "infineon,tcpwm";
			reg = <0x40380080 0x80>;
			resolution = <16>;
			status = "disabled";

			counter0_1: counter0_1 {
				compatible = "infineon,tcpwm-counter";
				system-interrupts = <553 4>;
				status = "disabled";
			};

			pwm0_1: pwm0_1 {
				compatible = "infineon,cat1-pwm";
				system-interrupts = <553 4>;
				#pwm-cells = <3>;
				status = "disabled";
			};

			tgpio0_1: tgpio0_1 {
