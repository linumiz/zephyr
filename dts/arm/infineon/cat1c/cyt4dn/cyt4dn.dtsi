		can1_1: can@40540200 {
			compatible = "infineon,cat1-can";
			reg = <0x40540200 0x200>, <0x40550000 0x4000>;
			reg-names = "m_can", "message_ram";
			system-interrupts = <103 3>, <109 3>;
