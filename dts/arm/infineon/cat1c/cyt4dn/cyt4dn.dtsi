#include <mem.h>
#include <zephyr/dt-bindings/pinctrl/ifx_cat1-pinctrl.h>
#include <zephyr/dt-bindings/ethernet/xlnx_gem.h>
#include <zephyr/dt-bindings/memory-attr/memory-attr-arm.h>

/ {
	cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		m0: cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-m0+";
			reg = <0>;
			clock-frequency = <100000000>;
		};
		m7_0: cpu@1 {
			device_type = "cpu";
			compatible = "arm,cortex-m7";
			reg = <1>;
			clock-frequency = <320000000>;
			status = "disabled";
		};
		m7_1: cpu@2 {
			device_type = "cpu";
			compatible = "arm,cortex-m7";
			reg = <2>;
			clock-frequency = <320000000>;
			status = "disabled";
		};
	};

	flash_controller: flash-controller@40240000 {
		compatible = "infineon,cat1-flash-controller-pdl";
		reg = < 0x40240000 0x10000 >;
		#address-cells = <1>;
		#size-cells = <1>;
		status = "okay";

		code_flash0: flash@10000000 {
			compatible = "soc-nv-flash";
			reg = <0x10000000 DT_SIZE_K(6336)>;
			write-block-size = <512>;
			erase-block-size = <32768>;
		};

		/* Work flash - Large sector (2KB Sectors) */
		work_flash0: flash@14000000 {
			compatible = "soc-nv-flash";
			reg = <0x14000000 0x18000>;
			write-block-size = <64>;
			erase-block-size = <2048>;
		};

		/* Work flash - Small sector (128B Sectors) */
		work_flash1: flash@14018000 {
			compatible = "soc-nv-flash";
			reg = <0x14018000 0x8000>;
			write-block-size = <64>;
			erase-block-size = <128>;
		};
	};

	sram0: memory@28000000 {
		compatible = "mmio-sram";
		reg = <0x28000000 DT_SIZE_K(256)>;
	};
	sram1: memory@28040000 {
		compatible = "mmio-sram";
		reg = <0x28040000 DT_SIZE_K(256)>;
	};
	sram2: memory@28080000 {
		compatible = "mmio-sram";
		reg = <0x28080000 DT_SIZE_K(128)>;
	};

	smif_0: smif0@40420000 {
		compatible = "infineon,serial-memory-qspi";
		reg = <0x40420000 0x10000>;
		#address-cells = <1>;
		#size-cells = <1>;
		pinctrl-0 = <
			&p23_0_smif0_data4
			&p23_1_smif0_data2
			&p23_2_smif0_data3
			&p23_3_smif0_data5
			&p23_4_smif0_rwds
			&p24_1_smif0_clk
			&p25_0_smif0_data0
			&p25_1_smif0_data6
			&p25_2_smif0_sel0
			&p25_3_smif0_data1
			&p25_4_smif0_data7
			&p25_5_smif0_sel1
		>;
		pinctrl-names = "default";
		hf-clock = <8>;
		status = "okay";

		hyperflash0: hyperflash0@0 {
			compatible = "infineon-ifx-hyperbus-flash";
			reg = <0x00000000 DT_SIZE_M(512)>;
			chip-select = <0>;
			write-block-size = <256>;
			erase-block-size = <4096>;

			partitions {
				#address-cells = <1>;
				#size-cells = <1>;
				compatible = "fixed-partitions";
			};
		};
	};

	smif_1: smif1@40430000 {
		compatible = "infineon,serial-memory-qspi";
		reg = <0x40430000 0x10000>;
		#address-cells = <1>;
		#size-cells = <1>;
		pinctrl-0 = <
			&p26_0_smif1_data4
			&p26_1_smif1_data2
			&p26_2_smif1_data3
			&p26_3_smif1_data5
			&p26_4_smif1_rwds
			&p27_1_smif1_clk
			&p28_0_smif1_data0
			&p28_1_smif1_data6
			&p28_3_smif1_data1
			&p28_4_smif1_data7
			&p28_5_smif1_sel1
		>;
		pinctrl-names = "default";
		hf-clock = <9>;
		status = "disabled";

		hyperram0: hyperram0@0 {
			compatible = "infineon-ifx-hyperbus-flash";
			reg = <0x00000000 DT_SIZE_M(64)>;
			write-block-size = <256>;
			erase-block-size = <1>; /* RAM cannot be erased */
			chip-select = <1>;

			partitions {
				#address-cells = <1>;
				#size-cells = <1>;
				compatible = "fixed-partitions";
			};
		};
	};
	
	m7_0_itcm: itcm@a0000000 {
		compatible = "zephyr,memory-region", "arm,itcm";
		reg = <0xa0000000 DT_SIZE_K(64)>;
		zephyr,memory-region = "M7_0_ITCM";
	};
	m7_0_dtcm: dtcm@a0010000 {
		compatible = "zephyr,memory-region", "arm,dtcm";
		reg = <0xa0010000 DT_SIZE_K(64)>;
		zephyr,memory-region = "M7_0_DTCM";
	};
	m7_1_itcm: itcm@a0100000 {
		compatible = "zephyr,memory-region", "arm,itcm";
		reg = <0xA0100000 DT_SIZE_K(64)>;
		zephyr,memory-region = "M7_1_ITCM";
	};
	m7_1_dtcm: dtcm@a0110000 {
		compatible = "zephyr,memory-region", "arm,dtcm";
		reg = <0xA0110000 DT_SIZE_K(64)>;
		zephyr,memory-region = "M7_1_DTCM";
	};

	soc {
		clocking: clocking {
			compatible = "infineon,cat1-clocking";
			status = "okay";
		};

		mbox:mbox@40220000 {
			compatible = "infineon,cat1-mbox-pdl";
			reg = <0x40220000 0x10000>;
			system-interrupts = <0 3>;
			#mbox-cells = <1>;
			status = "disabled";
		};

		pinctrl: pinctrl@40300000 {
			compatible = "infineon,cat1-pinctrl";
			reg = <0x40300000 0x20000>;
		};

		hsiom: hsiom@40300000 {
			compatible = "infineon,cat1-hsiom";
			reg = <0x40300000 0x4000>;
			system-interrupts = <21 6>, <20 6>;
			status = "disabled";
		};

		gpio_prt0: gpio@40310000 {
			compatible = "infineon,cat1-gpio";
			reg = <0x40310000 0x80>;
			system-interrupts = <24 2>;
			gpio-controller;
			ngpios = <6>;
			status = "disabled";
			#gpio-cells = <2>;
