		dma0: dw@40280000 {
			#dma-cells = <1>;
			compatible = "infineon,cat1-dma-pdl";
			reg = <0x40280000 0x10000>;
			dma-channels = <76>;
			interrupts = <296 5>, /* CH0 */
					    <297 5>, /* CH1 */
				            <298 5>, /* CH2 */
					    <299 5>, /* CH3 */
					    <300 5>, /* CH4 */
					    <301 5>, /* CH5 */
