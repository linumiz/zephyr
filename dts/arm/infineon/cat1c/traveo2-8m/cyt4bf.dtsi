			compatible = "infineon,cat1-sdhc-sdio";
			reg = <0x40460000 0x2000>;
			system-interrupts = <563 6>, /* SDIO wakeup interrupt for mxsdhc */
								<562 6>; /* Consolidated interrupt for mxsdhc */
			status = "disabled";
		};

		adc0: adc@40900000 {
			compatible = "infineon,ifx-sar";
			reg = <0x40900000 0x1000>;
			#io-channel-cells = <1>;
			system-interrupts = <123 3>;
			clock-frequency = <26670000>;
			ifx,peri-group = <IFX_PERI_GRP_INST_SEL(1, 0)>;
			ifx,peri-clk = <0x012A>;
			ifx,peri-div = <0>; /* 8-bit divider */
			ifx,peri-div-inst = <2>;
		};

		adc1: adc@40901000 {
			compatible = "infineon,ifx-sar";
			reg = <0x40901000 0x1000>;
			#io-channel-cells = <1>;
			system-interrupts = <155 3>;
			clock-frequency = <26670000>;
			ifx,peri-group = <IFX_PERI_GRP_INST_SEL(1, 0)>;
			ifx,peri-clk = <0x012B>;
			ifx,peri-div = <0>; /* 8-bit divider */
			ifx,peri-div-inst = <2>;
		};

		can0_0: can@40520000 {
			compatible = "infineon,cat1-can";
			reg = <0x40520000 0x200>, <0x40530000 0xA000>;
			reg-names = "m_can", "message_ram";
			system-interrupts = <73 2>, <78 2>;
			clocks = <&clk_hf2>;
			bosch,mram-cfg = <0x0 28 8 3 3 1 3 3>;
			status = "disabled";
		};
		can0_1: can@40520200 {
			compatible = "infineon,cat1-can";
			reg = <0x40520200 0x200>, <0x40530000 0xA000>;
			reg-names = "m_can", "message_ram";
			system-interrupts = <74 2>, <79 2>;
			clocks = <&clk_hf2>;
			bosch,mram-cfg = <0x2000 28 8 3 3 1 3 3>;
			status = "disabled";
		};
		can0_2: can@40520400 {
			compatible = "infineon,cat1-can";
			reg = <0x40520400 0x200>, <0x40530000 0xA000>;
			reg-names = "m_can", "message_ram";
			system-interrupts = <75 2>, <80 2>;
			clocks = <&clk_hf2>;
			bosch,mram-cfg = <0x4000 28 8 3 3 1 3 3>;
			status = "disabled";
		};
		can0_3: can@40520600 {
			compatible = "infineon,cat1-can";
			reg = <0x40520600 0x200>, <0x40530000 0xA000>;
			reg-names = "m_can", "message_ram";
			system-interrupts = <76 2>, <81 2>;
			clocks = <&clk_hf2>;
			bosch,mram-cfg = <0x6000 28 8 3 3 1 3 3>;
			status = "disabled";
		};
		can0_4: can@40520800 {
			compatible = "infineon,cat1-can";
			reg = <0x40520800 0x200>, <0x40530000 0xA000>;
			reg-names = "m_can", "message_ram";
			system-interrupts = <77 2>, <82 2>;
			clocks = <&clk_hf2>;
			bosch,mram-cfg = <0x8000 28 8 3 3 1 3 3>;
			status = "disabled";
		};

		can1_0: can@40540000 {
			compatible = "infineon,cat1-can";
			reg = <0x40540000 0x200>, <0x40550000 0xA000>;
			reg-names = "m_can", "message_ram";
			system-interrupts = <83 3>, <88 3>;
			clocks = <&clk_hf2>;
			bosch,mram-cfg = <0x0 28 8 3 3 1 3 3>;
			status = "disabled";
		};
		can1_1: can@40540200 {
			compatible = "infineon,cat1-can";
			reg = <0x40540200 0x200>, <0x40550000 0xA000>;
			reg-names = "m_can", "message_ram";
			system-interrupts = <84 3>, <89 3>;
			clocks = <&clk_hf2>;
			bosch,mram-cfg = <0x2000 28 8 3 3 1 3 3>;
			status = "disabled";
		};
		can1_2: can@40540400 {
			compatible = "infineon,cat1-can";
			reg = <0x40540400 0x200>, <0x40550000 0xA000>;
			reg-names = "m_can", "message_ram";
			system-interrupts = <85 3>, <90 3>;
			clocks = <&clk_hf2>;
			bosch,mram-cfg = <0x4000 28 8 3 3 1 3 3>;
			status = "disabled";
		};
		can1_3: can@40540600 {
			compatible = "infineon,cat1-can";
			reg = <0x40540600 0x200>, <0x40550000 0xA000>;
			reg-names = "m_can", "message_ram";
			system-interrupts = <86 3>, <91 3>;
			clocks = <&clk_hf2>;
			bosch,mram-cfg = <0x6000 28 8 3 3 1 3 3>;
			status = "disabled";
		};
		can1_4: can@40540800 {
			compatible = "infineon,cat1-can";
			reg = <0x40540800 0x200>, <0x40550000 0xA000>;
			reg-names = "m_can", "message_ram";
			system-interrupts = <87 3>, <92 3>;
			clocks = <&clk_hf2>;
			bosch,mram-cfg = <0x8000 28 8 3 3 1 3 3>;
			status = "disabled";
		};

		eth0: ethernet@40480000 {
			compatible = "xlnx,gem-controller";
			reg = <0x40481000 0x1000>, <0x40480000 0x1000>;

			eth0_mac: ethernet {
				compatible = "xlnx,gem";
				status = "disabled";
				system-interrupts = <556 4>, <557 4>;
				amba-ahb-burst-length = <XLNX_GEM_AMBA_AHB_BURST_INCR4>;
				hw-rx-buffer-size = <XLNX_GEM_HW_RX_BUFFER_SIZE_8KB>;
				hw-rx-buffer-offset = <0>;
				hw-tx-buffer-size-full;
				rx-buffer-descriptors = <16>;
				tx-buffer-descriptors = <16>;
				rx-buffer-size = <1536>;
				tx-buffer-size = <1536>;
				discard-rx-fcs;
				unicast-hash;
			};

			eth0_mdio: mdio {
				compatible = "xlnx,gem-mdio";
				status = "disabled";
				#address-cells = <1>;
				#size-cells = <0>;
			};
		};
	};
};
