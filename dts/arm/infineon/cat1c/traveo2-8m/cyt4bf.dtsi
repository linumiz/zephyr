#include <mem.h>
#include <zephyr/dt-bindings/pinctrl/ifx_cat1-pinctrl.h>
#include <zephyr/dt-bindings/ethernet/xlnx_gem.h>
#include <zephyr/dt-bindings/memory-attr/memory-attr-arm.h>

/ {
	flash_controller: flash-controller@40240000 {
		compatible = "infineon,cat1-flash-controller-pdl";
		reg = <0x40240000 0x10000>;
		#address-cells = <1>;
		#size-cells = <1>;
		status = "okay";

		/* Code flash - Large sector (32KB Sectors) */
		code_flash0: flash@10000000 {
			compatible = "soc-nv-flash";
			reg = <0x10000000 DT_SIZE_K(8128)>;
			write-block-size = <512>;
			erase-block-size = <32768>;
		};

		/* Code flash - Large sector (8KB Sectors) */
		code_flash1: flash@107F0000 {
			compatible = "soc-nv-flash";
			reg = <0x107F0000 DT_SIZE_K(256)>;
			write-block-size = <512>;
			erase-block-size = <8192>;
		};

		/* Work flash - Large sector (2KB Sectors) */
		work_flash0: flash@14000000 {
			compatible = "soc-nv-flash";
			reg = <0x14000000 DT_SIZE_K(192)>;
			write-block-size = <64>;
			erase-block-size = <2048>;
		};

		/* Work flash - Small sector (128B Sectors) */
		work_flash1: flash@14030000 {
			compatible = "soc-nv-flash";
			reg = <0x14030000 DT_SIZE_K(64)>;
			write-block-size = <64>;
			erase-block-size = <128>;
		};
	};

	sram0: memory@28000000 {
		compatible = "mmio-sram";
		reg = <0x28000000 DT_SIZE_K(256)>;
	};
	sram1: memory@28040000 {
		compatible = "mmio-sram";
		reg = <0x28040000 DT_SIZE_K(256)>;
	};
	sram2: memory@28080000 {
		compatible = "mmio-sram";
		reg = <0x28080000 DT_SIZE_K(128)>;
	};

	smif_0: smif0@40420000 {
		compatible = "infineon,serial-memory-qspi";
		reg = <0x40420000 0x10000>;
		#address-cells = <1>;
		#size-cells = <1>;
		status = "disabled";
	};

	m7_0_itcm: itcm@a0000000 {
		compatible = "zephyr,memory-region", "arm,itcm";
		reg = <0xa0000000 DT_SIZE_K(64)>;
		zephyr,memory-region = "M7_0_ITCM";
	};
	m7_0_dtcm: dtcm@a0010000 {
		compatible = "zephyr,memory-region", "arm,dtcm";
		reg = <0xa0010000 DT_SIZE_K(64)>;
		zephyr,memory-region = "M7_0_DTCM";
	};
	m7_1_itcm: itcm@a0100000 {
		compatible = "zephyr,memory-region", "arm,itcm";
		reg = <0xA0100000 DT_SIZE_K(64)>;
		zephyr,memory-region = "M7_1_ITCM";
	};
	m7_1_dtcm: dtcm@a0110000 {
		compatible = "zephyr,memory-region", "arm,dtcm";
		reg = <0xA0110000 DT_SIZE_K(64)>;
		zephyr,memory-region = "M7_1_DTCM";
	};

	soc {
		clocking: clocking {
			compatible = "infineon,cat1-clocking";
		};

		mbox: mbox@40220000 {
			compatible = "infineon,cat1-mbox-pdl";
			reg = <0x40220000 0x10000>;
			system-interrupts = <0 3>;
			#mbox-cells = <1>;
			status = "disabled";
		};

		pinctrl: pinctrl@40300000 {
			compatible = "infineon,cat1-pinctrl";
			reg = <0x40300000 0x20000>;
		};
		hsiom: hsiom@40300000 {
			compatible = "infineon,cat1-hsiom";
			reg = <0x40300000 0x4000>;
			system-interrupts = <21 6>, <20 6>;
			status = "disabled";
		};

		gpio_prt0: gpio@40310000 {
			compatible = "infineon,cat1-gpio";
			reg = <0x40310000 0x80>;
			system-interrupts = <22 2>;
