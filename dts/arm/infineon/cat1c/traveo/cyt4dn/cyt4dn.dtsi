		scb0: scb@40600000 {
                        compatible = "infineon,scb";
                        reg = <0x40600000 0x10000>;
                        interrupts = <20 3>;
			clk-dst = <0x0108>;
                        status = "disabled";
                };

		scb1: scb@40610000 {
